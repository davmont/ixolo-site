---
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangScript from '../components/LangScript.astro';
import { ui, href, type PageKey } from '../i18n/ui';
import { site, languages, type Lang } from '../site.config';
import { fmtText } from '../lib/ph';
import { url } from '../lib/base.mjs';

interface Props { lang: Lang; page: PageKey; title: string; description: string }
const { lang, page, title, description } = Astro.props;
const fullTitle = page === 'home' ? `${site.name} — ${fmtText(title)}` : `${fmtText(title)} · ${site.name}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={fmtText(description)} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  {Object.keys(languages).map((l) => (
    <link rel="alternate" hreflang={l} href={new URL(href(l as Lang, page), Astro.site ?? Astro.url)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(url('/'), Astro.site ?? Astro.url)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={fmtText(description)} />
  <LangScript />
</head>
<body>
  <a href="#main" class="sr-only">{ui[lang].skip}</a>
  <Header lang={lang} page={page} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
