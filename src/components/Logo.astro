---
// The Xolo mark + wordmark.  variant: color (light bg), inverse (dark bg), mono.
import { site } from '../site.config';
interface Props { variant?: 'color' | 'inverse' | 'mono'; size?: number; wordmark?: boolean }
const { variant = 'color', size = 40, wordmark = true } = Astro.props;
const c = {
  color:   { gill: '#D9577E', body: '#F6A5BC', ink: '#0F1E1C', text: 'var(--ink)' },
  inverse: { gill: '#F08CA8', body: '#F6A5BC', ink: '#0F1E1C', text: '#E6EEEB' },
  mono:    { gill: 'currentColor', body: 'none', ink: 'currentColor', text: 'currentColor' },
}[variant];
---
<span class="logo" style={`--logo-text:${c.text}`}>
  <svg aria-hidden="true" viewBox="0 0 64 52" width={size} height={size * 52 / 64}>
    <path d="M14 18 L4 10 M12 26 L2 26 M14 34 L4 42 M50 18 L60 10 M52 26 L62 26 M50 34 L60 42"
      stroke={c.gill} stroke-width="4.5" stroke-linecap="round" />
    <ellipse cx="32" cy="27" rx="20" ry="17" fill={c.body}
      stroke={variant === 'mono' ? 'currentColor' : 'none'} stroke-width="3" />
    <circle cx="25" cy="25" r="2.6" fill={c.ink} />
    <circle cx="39" cy="25" r="2.6" fill={c.ink} />
    <path d="M28 32 Q32 35 36 32" stroke={c.ink} stroke-width="1.8" fill="none" stroke-linecap="round" />
  </svg>
  {wordmark && <span class="word">{site.slug}</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  svg { display: block; flex-shrink: 0; }
  .word { font: 700 26px var(--f-head); letter-spacing: -.02em; color: var(--logo-text); }
</style>
