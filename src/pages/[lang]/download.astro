---
import Page from '../../layouts/Page.astro';
import { doc } from '../../i18n/ui';
import { fmt, html, text } from '../../lib/ph';
import { site, type Lang } from '../../site.config';
import copy from '../../i18n/pages/download';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const lang = Astro.params.lang as Lang;
const c = copy[lang];
const r = site.release;
const build = `git clone ${site.repo}.git
cd minix
git checkout ${site.repoBranch}
sh build.sh -m amd64 -U -u -j$(nproc) -O obj.amd64 -V MKLLVMCMDS=no release
OBJ=obj.amd64 CREATE_IMAGE_ONLY=1 IMG=${text('iso')} \\
  bash releasetools/amd64_cdimage.sh`;
---
<Page lang={lang} page="download" title={c.title} description={c.description}>
  <section class="section tight">
    <div class="wrap stack" style="--gap:20px">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="h1" set:html={fmt(c.h1)} />
      <p class="lead" set:html={fmt(c.lead)} />
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="wrap">
      <div class="card iso">
        <span class="tag">{c.recommended}</span>
        <h2 class="h2" style="font-size:32px">{c.isoH2}</h2>
        <p>{c.isoP}</p>
        <p class="mono sha">{c.sha}: <span set:html={html('sha256')} /></p>
        <div class="row" style="--gap:14px">
          <a href={r.isoUrl ?? '#'} class="btn btn-primary" set:html={fmt(c.isoBtn)} />
          <a href={r.signatureUrl ?? '#'} class="btn btn-ghost">{c.sigBtn}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="wrap stack" style="--gap:20px">
      <h2 class="h2" style="font-size:28px">{c.archH2}</h2>
      <div class="table-scroll">
        <table class="data">
          <thead><tr>{c.archHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.arch.map((row) => (
              <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td set:html={fmt(cell)} />)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="wrap row">
      <div class="card" id="requirements"><h3>{c.reqH3}</h3><p set:html={fmt(c.req)} /></div>
      <div class="card"><h3>{c.hwH3}</h3><p set:html={fmt(c.hw)} /></div>
      <div class="card">
        <h3>{c.snapH3}</h3><p>{c.snapP}</p>
        <a class="more" href={site.ci + '?query=branch%3A' + site.repoBranch}>{c.snapBtn}</a>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap row" style="--gap:32px">
      <div class="stack" style="flex:1 1 380px; --gap:16px">
        <h2 class="h2" style="font-size:28px">{c.verifyH2}</h2>
        <p class="muted">{c.verifyP}</p>
        <div class="term"><pre>sha256sum {text('iso')}
<span class="dim"># {text('sha256')}</span></pre></div>
      </div>
      <div class="stack" style="flex:1 1 480px; --gap:16px">
        <h2 class="h2" style="font-size:28px">{c.buildH2}</h2>
        <p class="muted">{c.buildP}</p>
        <div class="term"><pre>{build}</pre></div>
        <a class="more" href={doc(lang, 'develop/building')}>{c.buildMore}</a>
      </div>
    </div>
  </section>
</Page>
<style>
  .iso { padding: 36px; gap: 16px; border-color: var(--water); }
  .sha { word-break: break-all; }
  table th[scope='row'] { font: 600 15px var(--f-body); text-transform: none; letter-spacing: 0; color: var(--ink); }
</style>
